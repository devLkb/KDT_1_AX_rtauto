# Unity — 열 때 자동 생성되는 것들
unity/Library/
unity/Temp/
unity/Obj/
unity/Logs/
unity/UserSettings/
unity/MemoryCaptures/
unity/Screenshots/
unity/*.csproj
unity/*.sln

# Python
venv/
.venv/
vision/.vision/
__pycache__/
*.pyc
.ipynb_checkpoints/

# PyInstaller 산출물 — 저장소에 넣지 않는다.
# dg5f_teleop.exe는 onefile로 **132MB**라 GitHub의 100MB 파일 제한에 걸린다(push 자체가 거부됨).
# 배포는 GitHub Releases에 첨부하는 방식으로 한다 — vision/dg5f/BUILD.md 참조.
dist/
build/
*.manifest
build_log*.txt

# 로컬 환경변수·비밀값 (공유 가능한 예제 파일만 허용)
.env
.env.*
!.env.example

# 런타임 로그·산출물 (스크립트가 실행마다 생성)
vision/**/*.csv
vision/**/vision_dg5f_*.csv
vision/**/calib_log_*.csv
*.log
*.pid

# ML-Agents training/build outputs
training/results/
training/builds/
training/archives/*.tar.gz
unity/Assets/MLAgents/Grasp/Models/*.onnx

# 로컬 배포 압축본·편집기 백업
/*.tar.gz
/*.tgz
/*.zip
*.backup
*.bak
*~

# 네이티브 crash dump
core
core.*

# OS
Thumbs.db
.DS_Store

# Agents
*.omc
*.omx
*.claude
